# ─── GeraldOS Core ───
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
AUTH_SECRET=replace-with-32-byte-random-secret
DEV_AUTH=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Keycloak (Authentication · RBAC · SSO) ───
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=geraldos
KEYCLOAK_CLIENT_ID=geraldos-frontend
KEYCLOAK_CLIENT_SECRET=

# ─── Orthanc (Primary DICOM server · DICOMweb) ───
ORTHANC_URL=http://localhost:8042
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=orthanc

# ─── OHIF Viewer (web image viewer) ───
OHIF_URL=http://localhost:3001

# ─── Dicoogle (search & indexing) ───
DICOOGLE_URL=http://localhost:8095

# ─── HAPI FHIR (clinical interoperability) ───
FHIR_URL=http://localhost:8090/fhir

# ─── n8n (workflow automation) ───
N8N_URL=http://localhost:5678
N8N_WEBHOOK_BASE=http://localhost:5678/webhook
N8N_API_KEY=

# ─── LangGraph (AI agent orchestration) ───
LANGGRAPH_URL=http://localhost:8123
LANGGRAPH_API_KEY=
LANGGRAPH_ASSISTANT_ID=geraldos-agent

# ─── MinIO (object storage) ───
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=geraldos
MINIO_SECRET_KEY=geraldos-secret
MINIO_BUCKET=geraldos
MINIO_REGION=us-east-1

# ─── Redis (cache & queues) ───
REDIS_URL=redis://localhost:6379
